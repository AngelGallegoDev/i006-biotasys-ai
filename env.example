# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
EXTRACTION_MODEL=gemini-2.5-flash-lite
INTERPRETATION_MODEL=gemini-2.5-flash

# JWT / API Key Configuration
JWT_SECRET_KEY=your_shared_api_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Backend Callback Configuration
BACKEND_NEST_URL=

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# FastAPI Configuration
APP_NAME=Biotasys AI
APP_VERSION=1.0.0
DEBUG=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Render sets PORT automatically. Leave this empty locally unless needed.
PORT=

# CORS Configuration
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Logging Configuration
LOG_LEVEL=INFO
